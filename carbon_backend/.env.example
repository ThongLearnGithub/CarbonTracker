# Copy to .env and fill in. .env is git-ignored; this file is not.

# Required. postgresql:// URLs are switched to the psycopg 3 driver automatically.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/carbon_db

# Firebase project whose ID tokens /auth/firebase accepts.
FIREBASE_PROJECT_ID=carbon-tracker-622b1

# Optional
# ACCESS_TOKEN_TTL_DAYS=7
# LOG_LEVEL=INFO
# Exact browser origins allowed by CORS (JSON list). Any localhost port is allowed by default.
# CORS_ORIGINS=["https://carbon-tracker.example.com"]
# Set to an empty value to disable the localhost default in production.
# CORS_ORIGIN_REGEX=
